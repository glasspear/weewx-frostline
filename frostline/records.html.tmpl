#set $periods = [("alltime", "All-Time", $alltime_span, "%b %d, %Y %I:%M %p"), ("year", "This Year", $year, "%b %d, %Y %I:%M %p"), ("month", "This Month", $month, "%b %d %I:%M %p"), ("today", "Today", $day, "%I:%M %p")]

#set $runtime_config = {"page": "records", "stationCode": $station_code, "location": str($station.location).strip()}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <script>
    try {
      var p = new URLSearchParams(window.location.search).get("theme");
      var s = (p === "light" || p === "dark") ? p : localStorage.getItem("color-scheme");
      if (s === "light" || s === "dark") {
        document.documentElement.setAttribute("data-theme", s);
        document.querySelector('meta[name="color-scheme"]').content = s;
      }
    } catch (e) {}
  </script>
  <title>Records &mdash; $station_code | $brand_full</title>
  <link rel="icon" type="image/svg+xml" href="assets/icons/frostline-logo.svg?v=$asset_ver">
  <link rel="stylesheet" href="assets/css/style.css?v=$asset_ver">
</head>
<body class="page-records">
  <a href="#main-content" class="skip-link visually-hidden">Skip to weather records</a>

  <header class="app-header">
    <div class="top-brand-bar">
      <div class="brand-bar-inner">
        <div class="brand-left">
          <a href="index.html" class="brand-logo" aria-label="$brand_full Weather Dashboard">
            <svg class="brand-mark" viewBox="0 0 32 32" width="24" height="24" fill="none" aria-hidden="true">
              <g stroke="var(--accent-cyan, #00A8E8)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 2.8V13.4M16 18.6V29.2M12.8 6.4 16 9.6 19.2 6.4M13.9 10.2 16 12.2 18.1 10.2M12.8 25.6 16 22.4 19.2 25.6M13.9 21.8 16 19.8 18.1 21.8"/>
                <path transform="rotate(60 16 16)" d="M16 2.8V13.4M16 18.6V29.2M12.8 6.4 16 9.6 19.2 6.4M13.9 10.2 16 12.2 18.1 10.2M12.8 25.6 16 22.4 19.2 25.6M13.9 21.8 16 19.8 18.1 21.8"/>
                <path transform="rotate(120 16 16)" d="M16 2.8V13.4M16 18.6V29.2M12.8 6.4 16 9.6 19.2 6.4M13.9 10.2 16 12.2 18.1 10.2M12.8 25.6 16 22.4 19.2 25.6M13.9 21.8 16 19.8 18.1 21.8"/>
                <polygon points="16 13.4 18.25 14.7 18.25 17.3 16 18.6 13.75 17.3 13.75 14.7" fill="var(--accent-cyan, #00A8E8)" fill-opacity="0.22"/>
              </g>
              <circle cx="16" cy="16" r="1.2" fill="var(--accent-cyan, #00A8E8)"/>
            </svg>
            <span class="brand-wordmark">
              #if $brand_prefix
              <span class="brand-prefix">$brand_prefix</span>#slurp
              #end if
              <span class="brand-primary">$brand_primary</span><span class="brand-secondary">$brand_secondary</span>
            </span>
          </a>
        </div>
        <div class="brand-center">
          <h1 class="station-heading">$station.location &mdash; Records</h1>
        </div>
        <div class="brand-right">
          <span class="last-updated-badge">Updated $current.dateTime</span>
          <button type="button" class="icon-action-btn mobile-theme-btn" id="theme-toggle-btn" aria-label="Toggle light or dark theme" title="Toggle light/dark theme">
            <svg class="theme-icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
            </svg>
            <svg class="theme-icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>
            </svg>
          </button>
          <a href="charts.html" class="icon-action-btn" aria-label="Open weather charts">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="3 17 9 11 13 15 21 7"/>
              <polyline points="16 7 21 7 21 12"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <nav class="station-nav-bar" aria-label="Dashboard navigation">
      <div class="station-nav-inner">
        <ul class="nav-tabs">
          <li>
            <a href="index.html" class="nav-tab">
              <svg class="nav-tab-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5.5v-6h-5v6H4a1 1 0 0 1-1-1Z"/></svg>
              <span class="station-code-pill">$station_code</span>
              <span class="nav-label-desktop">Dashboard</span>
              <span class="nav-label-mobile">Home</span>
            </a>
          </li>
          <li>
            <a href="charts.html" class="nav-tab">
              <svg class="nav-tab-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="m7 15 4-4 4 3 5-6"/></svg>
              <span>Charts</span>
            </a>
          </li>
          <li>
            <a href="records.html" class="nav-tab is-active" aria-current="page">
              <svg class="nav-tab-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
              <span>Records</span>
            </a>
          </li>
          <li>
            <a href="wear.html" class="nav-tab">
              <svg class="nav-tab-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 4h3l3 4-3 2v10H6V10L3 8l3-4h3"/><path d="M9 4a3 3 0 0 0 6 0"/></svg>
              <span class="nav-label-desktop">What to Wear</span>
              <span class="nav-label-mobile">Wear</span>
            </a>
          </li>
          <li>
            <a href="station.html" class="nav-tab">
              <svg class="nav-tab-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="21"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="5" y1="9" x2="19" y2="9"/><circle cx="5" cy="7" r="2"/><circle cx="19" cy="7" r="2"/><rect x="9" y="13" width="6" height="4" rx="1"/><path d="m12 5 4-2-1 2z" fill="currentColor"/></svg>
              <span>Station</span>
            </a>
          </li>
        </ul>
        <div class="nav-theme-control">
          <label for="theme-select" class="visually-hidden">Color theme</label>
          <select id="theme-select" class="theme-select">
            <option value="auto">Auto</option>
            <option value="dark">Dark</option>
            <option value="light">Light</option>
          </select>
        </div>
      </div>
    </nav>
  </header>

  <main id="main-content" class="records-main">
    <div class="records-period-bar" role="group" aria-label="Records timeframe">
      #for $idx, ($p_id, $p_label, $p_span, $p_fmt) in enumerate($periods)
      #set $btn_cls = "records-period-btn is-active" if $idx == 0 else "records-period-btn"
      #set $pressed_str = "true" if $idx == 0 else "false"
      <button type="button" class="$btn_cls" data-period="$p_id" aria-pressed="$pressed_str">$p_label</button>
      #end for
    </div>

    #for $idx, ($p_id, $p_label, $p_span, $p_fmt) in enumerate($periods)
    #set $panel_hidden = "" if $idx == 0 else " hidden"
    <section class="records-panel" data-period-panel="$p_id" aria-label="$p_label weather records"$panel_hidden>
      <div class="records-grid">

        <article class="sensor-card record-card">
          <div class="card-header has-status-bar">
            <h2 class="card-header-title">Temperature &amp; Dew Point ($p_label)</h2>
          </div>
          <div class="card-body">
            <dl class="record-list">
              <div class="record-row">
                <dt>High Temperature</dt>
                <dd>
                  <span class="record-value is-cyan">$_rec_val($p_span.outTemp.max)</span>
                  <span class="record-time">$_rec_time($p_span.outTemp.max, $p_span.outTemp.maxtime, $p_fmt)</span>
                </dd>
              </div>
              <div class="record-row">
                <dt>Low Temperature</dt>
                <dd>
                  <span class="record-value is-cyan">$_rec_val($p_span.outTemp.min)</span>
                  <span class="record-time">$_rec_time($p_span.outTemp.min, $p_span.outTemp.mintime, $p_fmt)</span>
                </dd>
              </div>
              <div class="record-row">
                <dt>High Dew Point</dt>
                <dd>
                  <span class="record-value">$_rec_val($p_span.dewpoint.max)</span>
                  <span class="record-time">$_rec_time($p_span.dewpoint.max, $p_span.dewpoint.maxtime, $p_fmt)</span>
                </dd>
              </div>
              <div class="record-row">
                <dt>Low Dew Point</dt>
                <dd>
                  <span class="record-value">$_rec_val($p_span.dewpoint.min)</span>
                  <span class="record-time">$_rec_time($p_span.dewpoint.min, $p_span.dewpoint.mintime, $p_fmt)</span>
                </dd>
              </div>
              #try
              #if $p_span.appTemp.max.has_data
              <div class="record-row">
                <dt>High Feels Like</dt>
                <dd>
                  <span class="record-value">$_rec_val($p_span.appTemp.max)</span>
                  <span class="record-time">$_rec_time($p_span.appTemp.max, $p_span.appTemp.maxtime, $p_fmt)</span>
                </dd>
              </div>
              <div class="record-row">
                <dt>Low Feels Like</dt>
                <dd>
                  <span class="record-value">$_rec_val($p_span.appTemp.min)</span>
                  <span class="record-time">$_rec_time($p_span.appTemp.min, $p_span.appTemp.mintime, $p_fmt)</span>
                </dd>
              </div>
              #end if
              #except
              #pass
              #end try
            </dl>
          </div>
        </article>

        <article class="sensor-card record-card">
          <div class="card-header">
            <h2 class="card-header-title">Wind &amp; Rain ($p_label)</h2>
          </div>
          <div class="card-body">
            <dl class="record-list">
              <div class="record-row">
                <dt>Peak Wind Gust</dt>
                <dd>
                  <span class="record-value">$_rec_val($p_span.windGust.max)</span>
                  <span class="record-time">$_rec_time($p_span.windGust.max, $p_span.windGust.maxtime, $p_fmt)</span>
                </dd>
              </div>
              <div class="record-row">
                <dt>Highest Sustained Wind</dt>
                <dd>
                  <span class="record-value">$_rec_val($p_span.windSpeed.max)</span>
                  <span class="record-time">$_rec_time($p_span.windSpeed.max, $p_span.windSpeed.maxtime, $p_fmt)</span>
                </dd>
              </div>
              <div class="record-row">
                <dt>Average Wind Speed</dt>
                <dd>
                  <span class="record-value">$_rec_val($p_span.windSpeed.avg)</span>
                </dd>
              </div>
              <div class="record-row">
                <dt>Total Rainfall</dt>
                <dd>
                  <span class="record-value is-cyan">$_rec_rain_mm($p_span.rain.sum, $rain_scale, $rain_unit_label)</span>
                </dd>
              </div>
              <div class="record-row">
                <dt>Peak Rain Rate</dt>
                <dd>
                  <span class="record-value">$_rec_rain_mm($p_span.rainRate.max, $rainrate_scale, $rainrate_unit_label)</span>
                  <span class="record-time">$_rec_time($p_span.rainRate.max, $p_span.rainRate.maxtime, $p_fmt)</span>
                </dd>
              </div>
            </dl>
          </div>
        </article>

        <article class="sensor-card record-card">
          <div class="card-header">
            <h2 class="card-header-title">Barometer &amp; Humidity ($p_label)</h2>
          </div>
          <div class="card-body">
            <dl class="record-list">
              <div class="record-row">
                <dt>High Barometer</dt>
                <dd>
                  <span class="record-value">$_rec_val($p_span.barometer.max)</span>
                  <span class="record-time">$_rec_time($p_span.barometer.max, $p_span.barometer.maxtime, $p_fmt)</span>
                </dd>
              </div>
              <div class="record-row">
                <dt>Low Barometer</dt>
                <dd>
                  <span class="record-value">$_rec_val($p_span.barometer.min)</span>
                  <span class="record-time">$_rec_time($p_span.barometer.min, $p_span.barometer.mintime, $p_fmt)</span>
                </dd>
              </div>
              <div class="record-row">
                <dt>High Humidity</dt>
                <dd>
                  <span class="record-value">$_rec_val($p_span.outHumidity.max)</span>
                  <span class="record-time">$_rec_time($p_span.outHumidity.max, $p_span.outHumidity.maxtime, $p_fmt)</span>
                </dd>
              </div>
              <div class="record-row">
                <dt>Low Humidity</dt>
                <dd>
                  <span class="record-value">$_rec_val($p_span.outHumidity.min)</span>
                  <span class="record-time">$_rec_time($p_span.outHumidity.min, $p_span.outHumidity.mintime, $p_fmt)</span>
                </dd>
              </div>
            </dl>
          </div>
        </article>

        <article class="sensor-card record-card">
          <div class="card-header">
            <h2 class="card-header-title">Secondary &amp; Lightning ($p_label)</h2>
          </div>
          <div class="card-body">
            <dl class="record-list">
              #set $sec_hi_t = $_rec_val($p_span.inTemp.max)
              #set $sec_hi_t_tm = $_rec_time($p_span.inTemp.max, $p_span.inTemp.maxtime, $p_fmt)
              #set $sec_lo_t = $_rec_val($p_span.inTemp.min)
              #set $sec_lo_t_tm = $_rec_time($p_span.inTemp.min, $p_span.inTemp.mintime, $p_fmt)
              #try
              #if $p_span.extraTemp1.max.has_data
              #set $sec_hi_t = $_rec_val($p_span.extraTemp1.max)
              #set $sec_hi_t_tm = $_rec_time($p_span.extraTemp1.max, $p_span.extraTemp1.maxtime, $p_fmt)
              #set $sec_lo_t = $_rec_val($p_span.extraTemp1.min)
              #set $sec_lo_t_tm = $_rec_time($p_span.extraTemp1.min, $p_span.extraTemp1.mintime, $p_fmt)
              #end if
              #except
              #pass
              #end try
              <div class="record-row">
                <dt>High Tower Temp</dt>
                <dd>
                  <span class="record-value">$sec_hi_t</span>
                  <span class="record-time">$sec_hi_t_tm</span>
                </dd>
              </div>
              <div class="record-row">
                <dt>Low Tower Temp</dt>
                <dd>
                  <span class="record-value">$sec_lo_t</span>
                  <span class="record-time">$sec_lo_t_tm</span>
                </dd>
              </div>
              #set $sec_hi_h = $_rec_val($p_span.inHumidity.max)
              #set $sec_hi_h_tm = $_rec_time($p_span.inHumidity.max, $p_span.inHumidity.maxtime, $p_fmt)
              #try
              #if $p_span.extraHumid1.max.has_data
              #set $sec_hi_h = $_rec_val($p_span.extraHumid1.max)
              #set $sec_hi_h_tm = $_rec_time($p_span.extraHumid1.max, $p_span.extraHumid1.maxtime, $p_fmt)
              #end if
              #except
              #pass
              #end try
              <div class="record-row">
                <dt>High Tower Humidity</dt>
                <dd>
                  <span class="record-value">$sec_hi_h</span>
                  <span class="record-time">$sec_hi_h_tm</span>
                </dd>
              </div>
              #set $l_total = "0 Strikes"
              #try
              #if $p_span.lightning_strike_count.sum.has_data
              #set $l_cnt = int(round(float($p_span.lightning_strike_count.sum.raw)))
              #set $l_total = "1 Strike" if $l_cnt == 1 else str($l_cnt) + " Strikes"
              #end if
              #except
              #pass
              #end try
              <div class="record-row">
                <dt>Total Lightning Strikes</dt>
                <dd>
                  <span class="record-value">$l_total</span>
                </dd>
              </div>
            </dl>
          </div>
        </article>

      </div>
    </section>
    #end for
  </main>

  <footer class="site-footer">
    <span>$station.location &middot; $station.hardware &middot; WeeWX $station.version</span>
  </footer>

  <div id="status-toast" class="status-toast" role="status" aria-live="polite" hidden></div>

  <script>
    window.FROSTLINE_CONFIG = #echo json.dumps($runtime_config).replace('</', '<\\/')#;
  </script>
  <script src="assets/js/app.js?v=$asset_ver" defer></script>
</body>
</html>
